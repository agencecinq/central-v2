# ─── Auto-Resolve ────────────────────────────────────────────────────
# Variables à ajouter dans .env.local (CinqCentral V2) pour activer
# l'émission du webhook ticket.created vers le worker auto-resolve.
#
# Si AUTORESOLVE_WORKER_URL ou AUTORESOLVE_WEBHOOK_SECRET est manquant,
# l'émission du webhook est silencieusement skip (utile en dev local).

# URL publique du worker auto-resolve (sans slash final).
# Le worker écoute /webhooks/cinqcentral/ticket-created.
AUTORESOLVE_WORKER_URL=https://auto-resolve.up.railway.app

# Secret HMAC SHA-256 partagé pour signer le payload webhook.
# Doit être identique à la variable côté worker.
# Génère-le avec : openssl rand -hex 32
AUTORESOLVE_WEBHOOK_SECRET=

# Bearer token utilisé par le worker pour appeler les endpoints
# /api/internal/* de CinqCentral. Doit être identique côté worker.
# Génère-le avec : openssl rand -hex 32
AUTORESOLVE_INTERNAL_TOKEN=
