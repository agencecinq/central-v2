# ─── Server ──────────────────────────────────────────────────────────
PORT=3001
LOG_LEVEL=info
NODE_ENV=development

# ─── Auth partagée avec CinqCentral ──────────────────────────────────
# HMAC SHA-256 pour vérifier les webhooks entrants depuis CinqCentral.
AUTORESOLVE_WEBHOOK_SECRET=
# Bearer token pour appeler les endpoints /api/internal/* de CinqCentral.
AUTORESOLVE_INTERNAL_TOKEN=
# URL publique de CinqCentral (sans slash final).
CINQCENTRAL_BASE_URL=https://cinqcentral.agencecinq.com

# ─── Redis (BullMQ) ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Anthropic ───────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_CLASSIFIER_MODEL=claude-haiku-4-5-20251001
AGENT_MODEL=claude-sonnet-4-6
AGENT_TIMEOUT_MS=900000
AGENT_MAX_TURNS=40

# ─── GitHub ──────────────────────────────────────────────────────────
# PAT du machine-user `cinq-auto-resolve-bot`, scopes contents:write +
# pull_requests:write sur l'org `agencecinq` uniquement.
GITHUB_PAT=
# HMAC secret configuré sur le webhook GitHub (org agencecinq, event
# workflow_run). Génère-le avec : openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=

# ─── Slack ───────────────────────────────────────────────────────────
# Bot token @cinq-auto-resolve, scopes chat:write, chat:write.customize.
SLACK_BOT_TOKEN=
# Channel pour les alertes internes (budget, erreurs). Optionnel.
SLACK_INTERNAL_CHANNEL_ID=

# ─── Workdir ─────────────────────────────────────────────────────────
# Dossier où sont clonés les repos. Sera créé/nettoyé par le worker.
WORK_DIR=/tmp/auto-resolve
# TTL du cache de détection de stack (par projet).
STACK_CACHE_DAYS=7

# ─── Mode dry-run ────────────────────────────────────────────────────
# Phase 4: agent tourne mais pas de push GitHub. Passe à false en Phase 5.
DRY_RUN=true

# ─── Budget hard cap ─────────────────────────────────────────────────
MONTHLY_BUDGET_USD=200
